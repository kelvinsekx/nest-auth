// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum RentalStatus {
  PENDING
  ACTIVE
  RETURNED
  EXPIRED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model PendingUser {
  id  String  @id @default(cuid())
  email   String  @unique
  passwordHash  String
  token String

  createdAt DateTime @default(now())
}

model User {
  id  String  @id @default(cuid())
  email   String  @unique
  passwordHash  String @map("password")
  username String?
  role Role @default(USER)
  emailVerified Boolean @default(false)

  rentals Rental[]
  reviews Review[]
  resetTokens VerifyPasswordReset[]
  movies Movie[]

  createdAt DateTime @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
}

model Rental {
  id String @id @default(uuid())
  status RentalStatus @default(PENDING)

  rentedAt DateTime?
  dueAt DateTime?
  returnedAt DateTime?

  user User @relation(fields: [userId], references: [id])
  userId String

  movie Movie @relation(fields: [movieId], references: [id])
  movieId String

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([movieId])
}

model Review {
  id String @id @default(uuid())
  rating Int
  comment String
  status ReviewStatus @default(PENDING)

  userId String
  user User @relation(fields: [userId], references: [id])

  movieId String
  movie Movie @relation(fields: [movieId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, movieId])
}

model Movie {
  id  String  @id @default(uuid())
  title   String
  description String?  
  releaseYear  Int @map("year")
  genre String?
  rating Float? 
 
  rentals Rental[]
  reviews Review[]

  user User @relation(fields: [userId], references: [id])
  userId String
  
  createdAt DateTime @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
}

model VerifyPasswordReset {
  used Boolean @default(false)
  token String @id @unique

  userId String
  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}
